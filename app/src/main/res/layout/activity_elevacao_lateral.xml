<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/elevacao_lateral_main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    tools:context=".ElevacaoLateralActivity">

    <TextView
        android:id="@+id/titulo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="Tela de Elevação Lateral"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="@android:color/black"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Cabeçalhos das Colunas -->
    <TextView
        android:id="@+id/labelPeso"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="124dp"
        android:text="Peso (kg)"
        android:textStyle="bold"
        android:textAlignment="center"
        app:layout_constraintEnd_toStartOf="@+id/labelReps"
        app:layout_constraintHorizontal_chainStyle="spread"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/titulo" />

    <TextView
        android:id="@+id/labelReps"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Repetições"
        android:textStyle="bold"
        android:textAlignment="center"
        app:layout_constraintBaseline_toBaselineOf="@id/labelPeso"
        app:layout_constraintEnd_toStartOf="@+id/labelTempo"
        app:layout_constraintStart_toEndOf="@+id/labelPeso" />

    <TextView
        android:id="@+id/labelTempo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Tempo"
        android:textStyle="bold"
        android:textAlignment="center"
        app:layout_constraintBaseline_toBaselineOf="@id/labelPeso"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/labelReps" />

    <!-- Linha 1 -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilPeso1"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
        android:layout_width="90dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        app:layout_constraintEnd_toEndOf="@id/labelPeso"
        app:layout_constraintStart_toStartOf="@id/labelPeso"
        app:layout_constraintTop_toBottomOf="@id/labelPeso">

        <AutoCompleteTextView
            android:id="@+id/etPeso1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="0"
            android:inputType="numberDecimal"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:textAlignment="center" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilReps1"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
        android:layout_width="90dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@id/tilPeso1"
        app:layout_constraintEnd_toEndOf="@id/labelReps"
        app:layout_constraintStart_toStartOf="@id/labelReps"
        app:layout_constraintTop_toTopOf="@id/tilPeso1">

        <AutoCompleteTextView
            android:id="@+id/etReps1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="0"
            android:inputType="number"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:textAlignment="center" />
    </com.google.android.material.textfield.TextInputLayout>

    <TextView
        android:id="@+id/tvTempo1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="00:00"
        app:layout_constraintBottom_toBottomOf="@id/tilReps1"
        app:layout_constraintEnd_toEndOf="@id/labelTempo"
        app:layout_constraintStart_toStartOf="@id/labelTempo"
        app:layout_constraintTop_toTopOf="@id/tilReps1" />

    <!-- Linha 2 -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilPeso2"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
        android:layout_width="90dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        app:layout_constraintEnd_toEndOf="@id/tilPeso1"
        app:layout_constraintStart_toStartOf="@id/tilPeso1"
        app:layout_constraintTop_toBottomOf="@id/tilPeso1">

        <AutoCompleteTextView
            android:id="@+id/etPeso2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="0"
            android:inputType="numberDecimal"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:textAlignment="center" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilReps2"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
        android:layout_width="90dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@id/tilPeso2"
        app:layout_constraintEnd_toEndOf="@id/tilReps1"
        app:layout_constraintStart_toStartOf="@id/tilReps1"
        app:layout_constraintTop_toTopOf="@id/tilPeso2">

        <AutoCompleteTextView
            android:id="@+id/etReps2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="0"
            android:inputType="number"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:textAlignment="center" />
    </com.google.android.material.textfield.TextInputLayout>

    <TextView
        android:id="@+id/tvTempo2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="00:00"
        app:layout_constraintBottom_toBottomOf="@id/tilReps2"
        app:layout_constraintEnd_toEndOf="@id/tvTempo1"
        app:layout_constraintStart_toStartOf="@id/tvTempo1"
        app:layout_constraintTop_toTopOf="@id/tilReps2" />

    <!-- Linha 3 -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilPeso3"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
        android:layout_width="90dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        app:layout_constraintEnd_toEndOf="@id/tilPeso2"
        app:layout_constraintStart_toStartOf="@id/tilPeso2"
        app:layout_constraintTop_toBottomOf="@id/tilPeso2">

        <AutoCompleteTextView
            android:id="@+id/etPeso3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="0"
            android:inputType="numberDecimal"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:textAlignment="center" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilReps3"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
        android:layout_width="90dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@id/tilPeso3"
        app:layout_constraintEnd_toEndOf="@id/tilReps2"
        app:layout_constraintStart_toStartOf="@id/tilReps2"
        app:layout_constraintTop_toTopOf="@id/tilPeso3">

        <AutoCompleteTextView
            android:id="@+id/etReps3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="0"
            android:inputType="number"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:textAlignment="center" />
    </com.google.android.material.textfield.TextInputLayout>

    <TextView
        android:id="@+id/tvTempo3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="00:00"
        app:layout_constraintBottom_toBottomOf="@id/tilReps3"
        app:layout_constraintEnd_toEndOf="@id/tvTempo2"
        app:layout_constraintStart_toStartOf="@id/tvTempo2"
        app:layout_constraintTop_toTopOf="@id/tilReps3" />

    <Button
        android:id="@+id/button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="188dp"
        android:text="Play/Stop"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.498"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tilPeso3" />

</androidx.constraintlayout.widget.ConstraintLayout>