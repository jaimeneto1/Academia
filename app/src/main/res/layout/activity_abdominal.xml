<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/abdominal_main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    tools:context=".AbdominalActivity">

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="Tela de Abdominal"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="@android:color/black"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Cabeçalhos das Colunas -->
    <TextView
        android:id="@+id/labelReps"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="124dp"
        android:text="Repetições"
        android:textStyle="bold"
        app:layout_constraintEnd_toStartOf="@+id/labelExercicio"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvTitle" />

    <TextView
        android:id="@+id/labelExercicio"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Exercício"
        android:textStyle="bold"
        app:layout_constraintBaseline_toBaselineOf="@id/labelReps"
        app:layout_constraintEnd_toStartOf="@+id/labelTempo"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toEndOf="@+id/labelReps" />

    <TextView
        android:id="@+id/labelTempo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Tempo"
        android:textStyle="bold"
        app:layout_constraintBaseline_toBaselineOf="@id/labelReps"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toEndOf="@+id/labelExercicio" />

    <!-- Linha 1 -->
    <EditText
        android:id="@+id/etReps1"
        android:layout_width="80dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:hint="0"
        android:inputType="number"
        android:textAlignment="center"
        app:layout_constraintEnd_toEndOf="@id/labelReps"
        app:layout_constraintStart_toStartOf="@id/labelReps"
        app:layout_constraintTop_toBottomOf="@id/labelReps" />

    <EditText
        android:id="@+id/etExercicio1"
        android:layout_width="100dp"
        android:layout_height="wrap_content"
        android:hint="Tipo"
        android:inputType="text"
        android:textAlignment="center"
        app:layout_constraintBaseline_toBaselineOf="@id/etReps1"
        app:layout_constraintEnd_toEndOf="@id/labelExercicio"
        app:layout_constraintStart_toStartOf="@id/labelExercicio" />

    <TextView
        android:id="@+id/tvTempo1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="00:00"
        app:layout_constraintBottom_toBottomOf="@id/etExercicio1"
        app:layout_constraintEnd_toEndOf="@id/labelTempo"
        app:layout_constraintStart_toStartOf="@id/labelTempo"
        app:layout_constraintTop_toTopOf="@id/etExercicio1" />

    <!-- Linha 2 -->
    <EditText
        android:id="@+id/etReps2"
        android:layout_width="80dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:hint="0"
        android:inputType="number"
        android:textAlignment="center"
        app:layout_constraintEnd_toEndOf="@id/etReps1"
        app:layout_constraintStart_toStartOf="@id/etReps1"
        app:layout_constraintTop_toBottomOf="@id/etReps1" />

    <EditText
        android:id="@+id/etExercicio2"
        android:layout_width="100dp"
        android:layout_height="wrap_content"
        android:hint="Tipo"
        android:inputType="text"
        android:textAlignment="center"
        app:layout_constraintBaseline_toBaselineOf="@id/etReps2"
        app:layout_constraintEnd_toEndOf="@id/etExercicio1"
        app:layout_constraintStart_toStartOf="@id/etExercicio1" />

    <TextView
        android:id="@+id/tvTempo2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="00:00"
        app:layout_constraintBottom_toBottomOf="@id/etExercicio2"
        app:layout_constraintEnd_toEndOf="@id/tvTempo1"
        app:layout_constraintStart_toStartOf="@id/tvTempo1"
        app:layout_constraintTop_toTopOf="@id/etExercicio2" />

    <!-- Linha 3 -->
    <EditText
        android:id="@+id/etReps3"
        android:layout_width="80dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:hint="0"
        android:inputType="number"
        android:textAlignment="center"
        app:layout_constraintEnd_toEndOf="@id/etReps2"
        app:layout_constraintStart_toStartOf="@id/etReps2"
        app:layout_constraintTop_toBottomOf="@id/etReps2" />

    <EditText
        android:id="@+id/etExercicio3"
        android:layout_width="100dp"
        android:layout_height="wrap_content"
        android:hint="Tipo"
        android:inputType="text"
        android:textAlignment="center"
        app:layout_constraintBaseline_toBaselineOf="@id/etReps3"
        app:layout_constraintEnd_toEndOf="@id/etExercicio2"
        app:layout_constraintStart_toStartOf="@id/etExercicio2" />

    <TextView
        android:id="@+id/tvTempo3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="00:00"
        app:layout_constraintBottom_toBottomOf="@id/etExercicio3"
        app:layout_constraintEnd_toEndOf="@id/tvTempo2"
        app:layout_constraintStart_toStartOf="@id/tvTempo2"
        app:layout_constraintTop_toTopOf="@id/etExercicio3" />

    <Button
        android:id="@+id/button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="188dp"
        android:text="Play/Stop"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/etReps3" />

</androidx.constraintlayout.widget.ConstraintLayout>